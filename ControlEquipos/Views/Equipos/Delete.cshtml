@model ControlEquipos.Models.Equipo

@{
    ViewData["Title"] = "Eliminar equipo";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1>Eliminar equipo</h1>
            <p class="text-muted mb-0">Confirma la eliminación del equipo seleccionado.</p>
        </div>

        <div class="alert alert-warning" role="alert">
            Esta acción eliminará el equipo de forma permanente.
            Verifica la información antes de continuar.
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Id</dt>
                    <dd class="col-sm-9">@Model.Id</dd>

                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">@Model.Nombre</dd>

                    <dt class="col-sm-3">Tipo</dt>
                    <dd class="col-sm-9">@Model.Tipo</dd>

                    <dt class="col-sm-3">Marca</dt>
                    <dd class="col-sm-9">@Model.Marca</dd>

                    <dt class="col-sm-3">Modelo</dt>
                    <dd class="col-sm-9">@Model.Modelo</dd>

                    <dt class="col-sm-3">Serial</dt>
                    <dd class="col-sm-9">@Model.Serial</dd>

                    <dt class="col-sm-3">Estado</dt>
                    <dd class="col-sm-9">@Model.Estado</dd>
                </dl>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input asp-for="Id" type="hidden" />
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="submit" class="btn btn-danger">Eliminar equipo</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
