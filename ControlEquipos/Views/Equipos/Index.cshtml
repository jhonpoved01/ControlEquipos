@model IEnumerable<ControlEquipos.Models.Equipo>
@* La acción Index entrega una colección de equipos que esta vista recorre para construir el listado. *@

@{
    ViewData["Title"] = "Equipos";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1>Equipos</h1>
        <p class="text-muted mb-0">Consulta y administra los equipos registrados en el sistema.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo equipo</a>
</div>

@* TempData muestra una sola vez la confirmación enviada después de crear, editar o eliminar. *@
@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

@* Model.Any distingue entre el listado con registros y el estado vacío de la página. *@
@if (Model.Any())
{
    @* table-responsive permite desplazar horizontalmente la tabla en pantallas pequeñas. *@
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Serial</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @* Cada iteración representa un equipo recibido desde el controlador. *@
                @foreach (var equipo in Model)
                {
                    <tr>
                        <td>@equipo.Id</td>
                        <td>@equipo.Nombre</td>
                        <td>@equipo.Tipo</td>
                        <td>@equipo.Marca</td>
                        <td>@equipo.Modelo</td>
                        <td>@equipo.Serial</td>
                        <td>@equipo.Estado</td>
                        <td>
                            @* Estas acciones completan el flujo CRUD para el registro seleccionado. *@
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Edit" asp-route-id="@equipo.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Details" asp-route-id="@equipo.Id" class="btn btn-sm btn-info">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@equipo.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    @* Si no hay registros, se orienta al usuario hacia la creación del primer equipo. *@
    <div class="text-center border rounded p-4 p-md-5 bg-light shadow-sm">
        <h2>No hay equipos registrados</h2>
        <p class="text-muted">Actualmente no existen equipos registrados en el sistema.</p>
        <a asp-action="Create" class="btn btn-primary">Registrar primer equipo</a>
    </div>
}
